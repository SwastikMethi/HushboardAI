<?xml version="1.0" encoding="utf-8"?>
<!-- App manifest: the companion Activity and the keyboard service, in one process. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Model files are downloaded when the user asks. The vendor's libraries declare this
         too; the app declares it itself so its own downloader does not depend on theirs. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Voice tools record only after an explicit tap; the permission is asked for then. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:name=".KeyboardApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AiKeyboard">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Asks for the microphone when the user taps record; the keyboard cannot ask itself. -->
        <activity
            android:name=".ui.tools.MicPermissionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.AiKeyboard.Dialog" />

        <!-- Lets a result the user chose to share be read by the app it is shared with. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Only the system may bind the keyboard; it runs in the app's default process. -->
        <service
            android:name=".ime.AiInputMethodService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/input_method" />
        </service>
    </application>
</manifest>
