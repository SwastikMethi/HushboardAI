<?xml version="1.0" encoding="utf-8"?>
<!-- Kids Chat's "who is typing" switch: dark text on the filled name, light on the other. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/on_accent_blue" android:state_checked="true" />
    <item android:color="@color/text_primary" />
</selector>
