<?xml version="1.0" encoding="utf-8"?>
<!-- Switch thumb: white when on, a quieter grey when off. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/control_disabled" android:state_enabled="false" />
    <item android:color="@color/text_primary" android:state_checked="true" />
    <item android:color="@color/key_label_secondary" />
</selector>
