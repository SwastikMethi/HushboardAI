<?xml version="1.0" encoding="utf-8"?>
<!-- Switch track: the ordinary control blue when on, neutral when off. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/key_function" android:state_enabled="false" />
    <item android:color="@color/switch_on" android:state_checked="true" />
    <item android:color="@color/key_letter" />
</selector>
