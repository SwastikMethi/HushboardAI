<?xml version="1.0" encoding="utf-8"?>
<!-- One message in Kids Chat. The bubble is moved to the side of whoever is typing now and
     coloured to match, in ChatActivity. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="4dp">

    <!-- The frame around the bubble is what lets it sit on either side. -->
    <LinearLayout
        android:id="@+id/chat_bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="4dp"
        android:background="@drawable/bg_chat_bubble"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        tools:ignore="UselessParent">

        <TextView
            android:id="@+id/chat_bubble_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/chat_bubble_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="280dp"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <!-- Its spoken label names the sender, so it is set per message in ChatActivity. -->
        <ImageView
            android:id="@+id/chat_bubble_picture"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:maxWidth="220dp"
            android:maxHeight="220dp"
            android:scaleType="fitCenter"
            android:visibility="gone"
            tools:ignore="ContentDescription" />
    </LinearLayout>
</FrameLayout>
