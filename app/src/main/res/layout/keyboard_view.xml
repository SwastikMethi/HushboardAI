<?xml version="1.0" encoding="utf-8"?>
<!-- The keyboard: tool row, suggestion strip, then the key grid or the emoji panel. The AI
     panel sits on top of all of it at the same height. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/keyboard_background">

    <LinearLayout
        android:id="@+id/typing_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/toolbar_height"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp">

            <!-- Balances the settings button so the AI control sits in the middle. -->
            <Space
                android:layout_width="48dp"
                android:layout_height="match_parent" />

            <Space
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <com.example.aikeyboard.ime.view.AiToggleView
                android:id="@+id/ai_toggle"
                android:layout_width="wrap_content"
                android:layout_height="32dp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/tool_settings"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/open_keyboard_settings"
                android:focusable="false"
                android:src="@drawable/ic_settings" />
        </LinearLayout>

        <com.example.aikeyboard.ime.view.SuggestionStripView
            android:id="@+id/suggestions"
            android:layout_width="match_parent"
            android:layout_height="@dimen/suggestion_strip_height" />

        <!-- The key grid sets the height; the emoji panel fills the same space when shown. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.example.aikeyboard.ime.view.KeyGridView
                android:id="@+id/keys"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:id="@+id/emoji_panel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <androidx.emoji2.emojipicker.EmojiPickerView
                    android:id="@+id/emoji_picker"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/emoji_letters"
                        android:layout_width="72dp"
                        android:layout_height="match_parent"
                        android:background="?android:attr/selectableItemBackground"
                        android:contentDescription="@string/key_letters"
                        android:gravity="center"
                        android:text="ABC"
                        android:textColor="@color/key_label"
                        android:textSize="@dimen/key_function_label_size"
                        tools:ignore="HardcodedText" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/emoji_backspace"
                        android:layout_width="72dp"
                        android:layout_height="match_parent"
                        android:background="?android:attr/selectableItemBackground"
                        android:contentDescription="@string/key_backspace"
                        android:gravity="center"
                        android:text="⌫"
                        android:textColor="@color/key_label"
                        android:textSize="@dimen/key_label_size"
                        tools:ignore="HardcodedText" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <include
        android:id="@+id/ai_panel"
        layout="@layout/view_ai_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</FrameLayout>
