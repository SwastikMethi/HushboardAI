<?xml version="1.0" encoding="utf-8"?>
<!-- The keyboard's AI panel: master switch, the models that help while typing, and the way
     back. It covers the keyboard at the same height, so the app above never jumps. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_ai_panel"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/ai_panel_back"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/ai_panel_close"
            android:focusable="false"
            android:gravity="center_vertical"
            android:text="←"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            tools:ignore="HardcodedText" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:text="@string/ai_support"
            android:textColor="@color/text_primary"
            android:textSize="19sp"
            android:textStyle="bold" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/ai_panel_master"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/ai_support"
            android:focusable="false"
            app:trackTint="@color/ai_switch_track" />
    </LinearLayout>

    <TextView
        android:id="@+id/ai_panel_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:textColor="@color/key_label_secondary"
        android:textSize="14sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/ai_panel_models"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- An explicit action: the topic model runs only when this is tapped. -->
    <TextView
        android:id="@+id/ai_panel_tag"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="?android:attr/selectableItemBackground"
        android:focusable="false"
        android:gravity="center"
        android:text="@string/ai_panel_tag"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/ai_panel_manage"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:focusable="false"
            android:gravity="center"
            android:text="@string/ai_panel_manage"
            android:textColor="@color/accent_blue"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/ai_panel_close"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:focusable="false"
            android:gravity="center"
            android:text="@string/ai_panel_close"
            android:textColor="@color/accent_blue"
            android:textSize="15sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/ai_panel_on_device"
        android:textColor="@color/key_label_secondary"
        android:textSize="12sp" />
</LinearLayout>
