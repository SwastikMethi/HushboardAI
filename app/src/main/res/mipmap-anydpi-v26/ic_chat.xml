<?xml version="1.0" encoding="utf-8"?>
<!-- Kids Chat icon: a speech bubble on the switch-on blue, so it is not mistaken for the
     keyboard's own icon on the home screen. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/switch_on" />
    <foreground android:drawable="@drawable/ic_chat_foreground" />
    <monochrome android:drawable="@drawable/ic_chat_foreground" />
</adaptive-icon>
