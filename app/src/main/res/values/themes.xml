<?xml version="1.0" encoding="utf-8"?>
<!-- One fixed dark theme shared by the companion app and the keyboard. -->
<resources>
    <style name="Theme.AiKeyboard" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorOnPrimary">@color/on_accent_blue</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutlineVariant">@color/divider</item>
        <!-- Tonal buttons and containers stay neutral charcoal, not the default purple tint. -->
        <item name="colorSecondaryContainer">@color/surface_raised</item>
        <item name="colorOnSecondaryContainer">@color/text_primary</item>
        <item name="android:colorBackground">@color/canvas</item>
        <item name="android:statusBarColor">@color/canvas</item>
        <item name="android:navigationBarColor">@color/canvas</item>
        <item name="switchPreferenceCompatStyle">@style/SettingsSwitchRow</item>
    </style>

    <!-- A small prompt shown over whatever the user was doing (the microphone request). -->
    <style name="Theme.AiKeyboard.Dialog" parent="Theme.Material3.Dark.Dialog.Alert">
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorSurface">@color/surface_raised</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Settings rows use the app's Material switch instead of the older default one. -->
    <style name="SettingsSwitchRow" parent="Preference.SwitchPreferenceCompat.Material">
        <item name="widgetLayout">@layout/preference_switch</item>
    </style>

    <style name="PrivacyParagraph">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyLarge</item>
    </style>
</resources>
