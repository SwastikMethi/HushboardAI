<?xml version="1.0" encoding="utf-8"?>
<!-- Backup and device transfer (Android 12+). Same rule as backup_rules.xml: settings travel,
     the vendor SDK's install identifier does not. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="sharedpref"
            path="desert-ant.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="sharedpref"
            path="desert-ant.xml" />
    </device-transfer>
</data-extraction-rules>
